# AeroPrompter tracker configuration
# Copy to /etc/aeroprompter-tracker.env on the server.

# Loopback only — Caddy is the sole path in from the internet.
TRACKER_HOST=127.0.0.1
TRACKER_PORT=8787

# Not under any web root. systemd StateDirectory=aeroprompter creates this.
TRACKER_DB=/var/lib/aeroprompter/hits.db

# The single origin allowed to post hits.
TRACKER_ALLOWED_ORIGIN=https://aeroprompter.app

# Leave unset (or 0) to store daily-rotating salted hashes and no personal data.
# Setting this to 1 stores raw IP addresses instead — read the "Storing raw IPs"
# section of README.md first, it changes your obligations as data controller.
TRACKER_STORE_RAW_IP=0
