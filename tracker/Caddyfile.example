# AeroPrompter tracker — append to /etc/caddy/Caddyfile
#
# Caddy terminates TLS, sets X-Forwarded-For (which the tracker trusts for the
# visitor hash) and proxies to the loopback service. Nothing else is exposed.

stats.aeroprompter.app {
	encode zstd gzip

	# Public: the beacon endpoint and a health check, nothing else.
	@tracker path /hit /health
	handle @tracker {
		reverse_proxy 127.0.0.1:8787
	}

	# Private: the stats dashboard, behind basic auth.
	#
	# Generate the hash with:   caddy hash-password
	# then put it in /etc/caddy/dashboard.env as
	#   AEROPROMPTER_DASHBOARD_HASH=$2a$14$...
	# and add   EnvironmentFile=/etc/caddy/dashboard.env
	# to the caddy service (systemctl edit caddy).
	#
	# Keeping the hash out of the Caddyfile keeps it out of version control.
	# On Caddy older than 2.7 this directive is spelled `basicauth`.
	# The trailing * also matches /dashboard/, which browsers add readily —
	# without it that URL falls through to the 404 below and looks broken.
	handle /dashboard* {
		basic_auth {
			greg {$AEROPROMPTER_DASHBOARD_HASH}
		}
		reverse_proxy 127.0.0.1:8787
	}

	# Everything else — above all the database file — 404s.
	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		# The app already counts visitors; access logs would duplicate that in a
		# form that does contain IPs. Discard them.
		output discard
	}
}
